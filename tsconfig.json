{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "rootDir": "./",                                                         
    "outDir": "./dist",                                   
    "esModuleInterop": true, 
    "forceConsistentCasingInFileNames": true, 
    "moduleResolution": "node",
    "strict": true, 
    "skipLibCheck": true
  },
    "include": ["./node_modules/@prisma/client/**/*.ts", "./src/**/*.ts"],
  "exclude": ["node_modules, data"]
}